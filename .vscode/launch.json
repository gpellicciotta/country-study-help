{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Live Server",
        "request": "launch",
        "runtimeArgs": [
          "run",
          "live-server"
        ],
        "runtimeExecutable": "npm",
        "skipFiles": [
          "<node_internals>/**"
        ],
        "type": "node"
      },
      {
        "name": "Run Tools",
        "request": "launch",
        "runtimeArgs": [
          "js/cache-tools.mjs",
          "generate",
          "--input-dirs",  "data,js,img",
          "--output-file", "cache-data.json"
        ],
        "runtimeExecutable": "node",
        "skipFiles": [
          "<node_internals>/**"
        ],
        "type": "node"
      },
      {
        "name": "Debug Client",
        "request": "launch",
        "type": "chrome",
        "url": "http://localhost:5500",
        "webRoot": "${workspaceFolder}",
        "runtimeArgs": ["--auto-open-devtools-for-tabs"]
      },
      {
        "name": "Attach to Chrome",
        "port": 9222,
        "request": "attach",
        "type": "chrome",
        "url": "https://countries.pellicciotta.com",
        "webRoot": "${workspaceFolder}"
      }
    ],
    "compounds": [
        {
          "name": "Debug Client while running Live-Server",
          "configurations": ["Run Live Server", "Debug Client"]
        }
    ]
}