{
  "short_name": "Country Study Help",
  "name": "Country Study Help",
  "version": "1.0.2-pre",
  "description": "Search info about a country, or a do a quiz to memory flags, countries and capitals.",
  "scope": "/",
  "start_url": "/",
  "background_color": "#0e6eb8",
  "theme_color": "#0e6eb8",
  "display": "standalone",
  "shortcuts": [
    {
      "name": "Search",
      "url": "/search",
      "description": "Search for specific countries",
      "icons": [
        { "src": "/img/magnifying-glass-solid.svg",         "type": "image/svg+xml", "sizes": "any" },
        { "src": "/img/magnifying-glass-solid-512x512.png", "type": "image/png",     "sizes": "512x512" },
        { "src": "/img/magnifying-glass-solid-256x256.png", "type": "image/png",     "sizes": "256x256" }
